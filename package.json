{
  "name": "workout_mcp",
  "version": "1.0.0",
  "description": "A conversation-driven workout planner and journal, centered on a detailed exercise catalog.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "npm run prisma:generate && tsc --noEmit",
    "typecheck:test": "tsc --project tsconfig.test.json",
    "build": "npm run prisma:generate && tsc",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm run typecheck:test && npm run build && npm test",
    "start": "node --enable-source-maps dist/index.js",
    "prisma:format": "prisma format --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "migrate:create": "bash scripts/prisma-migrate.sh dev --create-only",
    "migrate:dev": "bash scripts/prisma-migrate.sh dev",
    "migrate:status": "bash scripts/prisma-migrate.sh status",
    "migrate:deploy": "bash scripts/prisma-migrate.sh deploy",
    "database:check": "npm run prisma:generate && bash scripts/database-check.sh",
    "test:integration": "npm run prisma:generate && bash scripts/test-integration.sh",
    "docs:tools:generate": "bash scripts/tool-reference.sh generate",
    "docs:tools:check": "bash scripts/tool-reference.sh check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@cisco_open/mcptoolkit-contract": "2.0.5",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/express": "5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "express": "5.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  }
}
