# Copy this file to .env only if you do not already have one, then edit it.
# Replace every placeholder with a deliberately selected existing database/role.
# Include a URL-encoded password after YOUR_ROLE when authentication requires it.
# Exported environment variables take precedence over this optional local file.
DATABASE_URL=postgresql://YOUR_ROLE@YOUR_HOST:YOUR_PORT/YOUR_DATABASE
# For a Unix socket, use this shape instead (encode the absolute directory):
# DATABASE_URL=postgresql://YOUR_ROLE@localhost:YOUR_PORT/YOUR_DATABASE?host=YOUR_URL_ENCODED_ABSOLUTE_SOCKET_DIRECTORY
# Integration tests require a separate explicit admin URL with CREATEDB privileges.
# TEST_DATABASE_ADMIN_URL=postgresql://YOUR_ROLE@YOUR_HOST:YOUR_PORT/YOUR_ADMIN_DATABASE
